# Environment Variables Template
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will not be committed

# ============================================
# Blockchain Configuration
# ============================================

# Moon Island ETH Testnet
VITE_MOON_ISLAND_RPC_URL=https://rpc.moonisland.eth
VITE_MOON_ISLAND_CHAIN_ID=0x123456
VITE_MOON_ISLAND_BLOCK_EXPLORER=https://explorer.moonisland.eth

# Deployment Account (Moon Island Testnet)
# WARNING: Never commit private keys to git!
PRIVATE_KEY=your_private_key_here

# ============================================
# Web3Auth Configuration
# ============================================

# Web3Auth Client ID (from https://dashboard.web3auth.io)
VITE_WEB3AUTH_CLIENT_ID=your_web3auth_client_id_here

# Web3Auth Network (sapphire_devnet, sapphire_mainnet, cyan, etc.)
VITE_WEB3AUTH_NETWORK=sapphire_devnet

# ============================================
# Chain Configuration
# ============================================

# Default Chain (mainnet, sepolia, moonisland, etc.)
VITE_DEFAULT_CHAIN=moonisland

# Ethereum Mainnet
VITE_ETH_MAINNET_RPC_URL=https://rpc.ankr.com/eth

# Sepolia Testnet
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# BSC Mainnet
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# BSC Testnet
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# Solana Devnet
VITE_SOUL_TOKEN_SOLANA=HNjY4deYs1Nuvui7kQwHppmRUw7tiUEPCSEC4q8AH7E6
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# ============================================
# API Keys
# ============================================

# Google Gemini API (optional, for AI assistant fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# BSCScan API Key (for contract verification)
BSCSCAN_API_KEY=your_bscscan_api_key_here
